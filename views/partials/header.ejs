<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> | Cybex</title>
    <link rel="stylesheet" href="/css/style.css">
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <!-- Main JavaScript -->
    <script src="/js/main.js" defer></script>
</head>
<body>
    <header>
        <nav class="navbar">
            <div class="nav-brand">
                <a href="/" class="brand-link">
                    <div class="brand-main"><span class="brand-highlight">Cy</span>bex</div>
                    <div class="brand-sub"><span class="brand-highlight">Cons</span>truction</div>
                </a>
            </div>
            <div class="nav-toggle" id="navToggle">
                <i class="fas fa-bars"></i>
            </div>
            <div class="nav-menu">
                <ul class="nav-links" id="navLinks">
                    <li><a href="#services" class="<%= active === 'services' ? 'active' : '' %>">Our Services</a></li>
                    <li><a href="#about" class="<%= active === 'about' ? 'active' : '' %>">About Us</a></li>
                    <li><a href="#projects" class="<%= active === 'projects' ? 'active' : '' %>">Projects</a></li>
                    <li><a href="#testimonials" class="<%= active === 'testimonials' ? 'active' : '' %>">Testimonials</a></li>
                    <li><a href="#contact" class="<%= active === 'contact' ? 'active' : '' %>">Contact</a></li>
                </ul>
            </div>
        </nav>
    </header>

    <!-- Contact Form Popup -->
    <div id="contactPopup" class="popup-overlay">
        <div class="popup-content">
            <span class="close-popup">&times;</span>
            <h2>Submit a general sales enquiry</h2>
            <p class="form-description">Please fill out the form below and we will get back to you as soon as possible</p>
            
            <form id="contactForm" class="popup-form">
                <div class="form-group">
                    <label>First name<span class="required">*</span></label>
                    <input type="text" id="firstName" name="firstName" placeholder="Please enter a first name" required>
                </div>

                <div class="form-group">
                    <label>Last name<span class="required">*</span></label>
                    <input type="text" id="lastName" name="lastName" placeholder="Please enter a last name" required>
                </div>

                <div class="form-group">
                    <label>Email address<span class="required">*</span></label>
                    <input type="email" id="email" name="email" placeholder="Please enter an email address" required>
                </div>

                <div class="form-group">
                    <label>Phone number<span class="required">*</span> <span class="subtitle">(please include area code if using a landline number)</span></label>
                    <input type="tel" id="phone" name="phone" placeholder="Please enter a phone number" required>
                </div>

                <div class="form-group">
                    <label>Where are you looking to build?<span class="required">*</span></label>
                    <div class="search-input-wrapper">
                        <input type="text" id="location" name="location" placeholder="Suburb, postcode or estate" required>
                        <span class="search-icon"><i class="fas fa-search"></i></span>
                    </div>
                </div>

                <div class="form-group">
                    <label>Do you own land already?<span class="required">*</span></label>
                    <div class="select-wrapper">
                        <select id="ownLand" name="ownLand" required>
                            <option value="">Please select</option>
                            <option value="yes">Yes</option>
                            <option value="no">No</option>
                            <option value="looking">Currently looking</option>
                        </select>
                    </div>
                </div>

                <div class="form-group">
                    <label>Is there any other information we need to know to be able to assist with your enquiry?</label>
                    <textarea id="additionalInfo" name="additionalInfo" placeholder="Please add any other details here" rows="4"></textarea>
                </div>

                <div class="privacy-notice">
                    <p>Information you provide will be used for the purpose of assisting you with your enquiry & to subscribe you to our direct marketing updates. If you don't wish to be on our marketing list, please use the unsubscribe facility in our emails or call us on 1300 786 773.</p>
                </div>

                <button type="submit" class="submit-btn">Submit</button>
            </form>
        </div>
    </div>

    <!-- Success Message Popup -->
    <div id="successPopup" class="popup-overlay">
        <div class="popup-content success-popup">
            <span class="close-popup">&times;</span>
            <div class="success-message">
                <i class="fas fa-check-circle"></i>
                <h2>Thank You!</h2>
                <p>We have received your message and will contact you soon.</p>
            </div>
        </div>
    </div>

    <!-- Error Popup -->
    <div id="errorPopup" class="popup-overlay error-popup">
        <div class="popup-content">
            <span class="close-popup">&times;</span>
            <div class="error-message">
                <i class="fas fa-exclamation-circle"></i>
                <h2>Oops!</h2>
                <p id="errorText">Something went wrong. Please try again.</p>
            </div>
        </div>
    </div>

    <style>
    .popup-overlay {
        display: none;
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-color: rgba(0, 0, 0, 0.7);
        z-index: 1000;
        justify-content: center;
        align-items: center;
        overflow-y: auto;
        padding: 2rem 0;
    }

    .popup-content {
        background-color: #fff;
        padding: 2.5rem;
        border-radius: 8px;
        width: 90%;
        max-width: 600px;
        position: relative;
        margin: auto;
    }

    .popup-content h2 {
        font-size: 2rem;
        color: #1a1a1a;
        margin-bottom: 1rem;
        font-weight: 600;
    }

    .form-description {
        color: #666;
        margin-bottom: 2rem;
        font-size: 1.1rem;
    }

    .close-popup {
        position: absolute;
        right: 1.5rem;
        top: 1.5rem;
        font-size: 1.8rem;
        cursor: pointer;
        color: #666;
        transition: color 0.3s ease;
    }

    .form-group {
        margin-bottom: 1.5rem;
    }

    .form-group label {
        display: block;
        margin-bottom: 0.5rem;
        color: #333;
        font-weight: 500;
    }

    .required {
        color: #e41e31;
        margin-left: 2px;
    }

    .subtitle {
        font-size: 0.9rem;
        color: #666;
        font-weight: normal;
    }

    .form-group input,
    .form-group textarea,
    .form-group select {
        width: 100%;
        padding: 0.8rem 1rem;
        border: 1px solid #ddd;
        border-radius: 4px;
        font-size: 1rem;
        color: #333;
        transition: border-color 0.3s ease;
    }

    .form-group input:focus,
    .form-group textarea:focus,
    .form-group select:focus {
        outline: none;
        border-color: #007bff;
    }

    .search-input-wrapper {
        position: relative;
    }

    .search-icon {
        position: absolute;
        right: 1rem;
        top: 50%;
        transform: translateY(-50%);
        color: #666;
    }

    .select-wrapper {
        position: relative;
    }

    .select-wrapper::after {
        content: '';
        position: absolute;
        right: 1rem;
        top: 50%;
        transform: translateY(-50%);
        border-left: 5px solid transparent;
        border-right: 5px solid transparent;
        border-top: 5px solid #666;
        pointer-events: none;
    }

    .form-group select {
        appearance: none;
        -webkit-appearance: none;
        -moz-appearance: none;
        background-color: white;
        cursor: pointer;
    }

    .privacy-notice {
        margin: 1.5rem 0;
        font-size: 0.9rem;
        color: #666;
        line-height: 1.4;
    }

    .submit-btn {
        width: auto;
        min-width: 120px;
        padding: 1rem 2rem;
        background-color: #2d5a87;
        color: white;
        border: none;
        border-radius: 4px;
        font-size: 1rem;
        font-weight: 600;
        cursor: pointer;
        transition: background-color 0.3s ease;
    }

    .submit-btn:hover {
        background-color: #1e4a77;
    }

    @media (max-width: 768px) {
        .popup-content {
            padding: 1.5rem;
            margin: 1rem;
            width: calc(100% - 2rem);
        }

        .popup-content h2 {
            font-size: 1.5rem;
        }
    }

    .error-popup .popup-content {
        border-left: 4px solid #e41e31;
    }

    .error-popup .error-message {
        text-align: center;
        padding: 1rem;
    }

    .error-popup i {
        font-size: 3rem;
        color: #e41e31;
        margin-bottom: 1rem;
    }

    .error-popup h2 {
        color: #e41e31;
        margin-bottom: 1rem;
    }

    .error-popup p {
        color: #666;
        font-size: 1.1rem;
        line-height: 1.4;
    }
    </style>

    <main> 