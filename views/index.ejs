<%- include('partials/header') %>

<section class="hero">
    <div class="hero-content">
        <h1>Building Excellence, Delivering Dreams</h1>
        <p>Your trusted partner in construction excellence since 1995</p>
        <a href="#contact" class="cta-button">Get Started</a>
    </div>
</section>

<section class="promo-slider">
    <div class="slider-container">
        <div class="slider-wrapper" id="sliderWrapper">
            <!-- Slide 1 -->
            <div class="slide">
                <div class="slide-content">
                    <img src="/images/home-fully-loaded.jpg" alt="First Home Package">
                    <div class="slide-text">
                        <h2>Your First Home, Fully Loaded</h2>
                        <p class="price">from $182,900*</p>
                        <a href="/promotions/first-home" class="slide-btn">Learn More</a>
                    </div>
                </div>
            </div>

            <!-- Slide 2 -->
            <div class="slide">
                <div class="slide-content">
                    <img src="/images/omega-appliances.jpg" alt="Omega Appliance Promotion">
                    <div class="slide-text">
                        <h2>Limited Time Offer: Omega Appliance Promotion</h2>
                        <a href="/promotions/omega" class="slide-btn">View Offer</a>
                    </div>
                </div>
            </div>

            <!-- Slide 3 -->
            <div class="slide">
                <div class="slide-content">
                    <img src="/images/townhomes.jpg" alt="Townhomes">
                    <div class="slide-text">
                        <h2>FIXED PRICE TURNKEY</h2>
                        <h3>TOWNHOMES FROM $444,900*</h3>
                        <a href="/townhomes" class="slide-btn">Discover More</a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Navigation Arrows -->
        <button class="slider-nav prev" id="prevBtn">
            <i class="fas fa-chevron-left"></i>
        </button>
        <button class="slider-nav next" id="nextBtn">
            <i class="fas fa-chevron-right"></i>
        </button>

        <!-- Slider Dots -->
        <div class="slider-dots">
            <button class="dot active" data-index="0"></button>
            <button class="dot" data-index="1"></button>
            <button class="dot" data-index="2"></button>
        </div>
    </div>

    <!-- Promotion Navigation -->
    <div class="promo-navigation">
        <button class="nav-btn active">Current offers</button>
        <button class="nav-btn">Latest news</button>
    </div>
</section>

<section class="features">
    <h2>Why Choose Us</h2>
    <div class="features-grid">
        <div class="feature-card">
            <i class="fas fa-medal"></i>
            <h3>Quality Assurance</h3>
            <p>We maintain the highest standards in construction and safety</p>
        </div>
        <div class="feature-card">
            <i class="fas fa-clock"></i>
            <h3>On-Time Delivery</h3>
            <p>We complete projects within agreed timeframes</p>
        </div>
        <div class="feature-card">
            <i class="fas fa-users"></i>
            <h3>Expert Team</h3>
            <p>Our team consists of highly skilled professionals</p>
        </div>
        <div class="feature-card">
            <i class="fas fa-dollar-sign"></i>
            <h3>Competitive Pricing</h3>
            <p>Quality construction at reasonable rates</p>
        </div>
    </div>
</section>


<!-- Construction Services Section -->
<section id="services" class="services-section">
    <div class="section-header">
        <h2>Our Construction Services</h2>
        <p>Professional and quality construction services tailored to meet the unique needs of each project</p>
    </div>
    <div class="services-grid">
        <div class="service-card">
            <i class="fas fa-building service-icon"></i>
            <h3>Commercial Construction</h3>
            <p>Office buildings, retail spaces, and industrial facilities built to the highest standards.</p>
        </div>
        <div class="service-card">
            <i class="fas fa-home service-icon"></i>
            <h3>Residential Projects</h3>
            <p>Custom homes and residential developments with attention to detail and quality.</p>
        </div>

        <div class="service-card">
            <i class="fas fa-store service-icon"></i>
            <h3>Retail Construction</h3>
            <p>Modern retail spaces and shopping centers designed for optimal customer experience.</p>
        </div>
        <div class="service-card">
            <i class="fas fa-hospital service-icon"></i>
            <h3>Medical Facilities</h3>
            <p>Specialized healthcare construction with strict adherence to medical facility standards.</p>
        </div>
        <div class="service-card">
            <i class="fas fa-tools service-icon"></i>
            <h3>Project Management</h3>
            <p>Comprehensive project management services from planning to completion.</p>
        </div>
        <div class="service-card">
            <i class="fas fa-hard-hat service-icon"></i>
            <h3>Interior Renovations</h3>
            <p>Complete interior renovation and remodeling services for any space.</p>
        </div>
    </div>
</section>

